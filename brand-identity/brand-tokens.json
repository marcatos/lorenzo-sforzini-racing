      "type_shear_ref": 0.36,
      "inset_ratio_default": 0.08,
      "soft_ends": false,
      "colors": [
        "ice",
        "silver",
        "electric_blue"
      ],
      "max_racing_accent_per_layout": 1,
      "note": "Parallelogram with vertical ends \u2014 never rotated rectangles"
